# 複製成 secrets.env 後填寫（secrets.env 已在 .gitignore 裡），再跑 python3 scripts/gen_secrets.py

# WPA2-Personal 網絡
WIFI_SSID=
WIFI_PASSWORD=

# 可選：WPA2-Enterprise（PEAP/TTLS + MSCHAPv2，如 eduroam）。EAP_SSID 非空時取代上面的網絡。
# 不驗證 RADIUS 服務器證書。
EAP_SSID=
EAP_IDENTITY=
EAP_USERNAME=
EAP_PASSWORD=

# 雲盤服務（server/clouddisk_server.py 前面的 HTTPS 地址，不帶結尾斜槓）和它的 token。
# 留空則固件走本地模式：扇區直通 SD 卡，沒卡用 PSRAM 內存盤。
CLOUDDISK_URL=
CLOUDDISK_TOKEN=
